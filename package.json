{
  "name": "orbis-khata",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node pwa/worker-check.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b",
    "quality:knip": "knip --no-progress",
    "quality:jscpd": "jscpd src --config .jscpd.json --fail-on-empty --exit-code 1",
    "test:e2e": "playwright test --config playwright.central.config.ts",
    "check": "npm test -- --run && npx oxlint",
    "test:sql": "node scripts/verify-lottery-rows.mjs && node scripts/verify-production.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-bengali": "5.3.0",
    "@fontsource/noto-serif-bengali": "5.3.0",
    "@supabase/supabase-js": "2.116.0",
    "@tailwindcss/postcss": "4.1.18",
    "fflate": "0.8.3",
    "html2canvas": "1.4.1",
    "jspdf": "4.2.1",
    "lucide-react": "0.468.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "4.1.18"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "4.1.12",
    "fast-check": "4.3.0",
    "jscpd": "5.2.1",
    "jsdom": "30.1.0",
    "knip": "6.36.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "source-map-js": "1.2.2",
    "smol-toml": "1.9.0"
  }
}
